<div class="d-flex flex-wrap gap-2 align-items-center">
    <select name="output" class="form-select form-select-sm w-auto" aria-label="{{ __('Output format', 'assetlabel') }}">
        {% for value, label in outputs %}
            <option value="{{ value }}" {{ value == default_output ? 'selected' : '' }}>{{ label }}</option>
        {% endfor %}
    </select>
    <button type="submit" name="massiveaction" value="1" class="btn btn-sm btn-primary">
        <i class="ti ti-qrcode"></i>
        <span>{{ __('Generate', 'assetlabel') }}</span>
    </button>
</div>
<div class="form-text">
    {{ __('PDF: one label per page. PNG: several labels are packed in a ZIP archive.', 'assetlabel') }}
    {% if outputs.printer is defined %}
        {{ __('Printer: all labels are sent to the printer as one job.', 'assetlabel') }}
    {% endif %}
</div>

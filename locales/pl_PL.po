# Asset Label - Polish translation.
msgid ""
msgstr ""
"Project-Id-Version: assetlabel 1.0.0\n"
"Language: pl_PL\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=3; plural=(n==1 ? 0 : n%10>=2 && n%10<=4 && (n%100<12 || n%100>14) ? 1 : 2);\n"

msgid "Asset Label"
msgstr "Etykiety zasobów"

msgid "Label"
msgid_plural "Labels"
msgstr[0] "Etykieta"
msgstr[1] "Etykiety"
msgstr[2] "Etykiet"

msgid "Print labels"
msgstr "Drukuj etykiety"

msgid "Generate"
msgstr "Generuj"

msgid "PDF: one label per page. PNG: several labels are packed in a ZIP archive."
msgstr "PDF: jedna etykieta na stronę. PNG: wiele etykiet trafia do archiwum ZIP."

msgid "Output format"
msgstr "Format wyjściowy"

msgid "Label preview"
msgstr "Podgląd etykiety"

msgid "Download label"
msgstr "Pobierz etykietę"

msgid "Labels are ready"
msgstr "Etykiety są gotowe"

msgid "The download should start automatically. If it does not, use the button below."
msgstr "Pobieranie powinno rozpocząć się automatycznie. Jeśli tak się nie stanie, użyj przycisku poniżej."

msgid "Download %s"
msgstr "Pobierz %s"

msgid "This file is no longer available. Please generate the labels again."
msgstr "Ten plik nie jest już dostępny. Wygeneruj etykiety ponownie."

msgid "The QR code content is empty."
msgstr "Treść kodu QR jest pusta."

msgid "The QR code content is too long."
msgstr "Treść kodu QR jest zbyt długa."

msgid "The QR code content is too long to be printed legibly on this label."
msgstr "Treść kodu QR jest zbyt długa, by czytelnie wydrukować go na tej etykiecie."

msgid "The logo must be a PNG, JPEG, GIF or WebP image of at most 2 MB and 5000 × 5000 pixels."
msgstr "Logo musi być obrazem PNG, JPEG, GIF lub WebP o rozmiarze do 2 MB i 5000 × 5000 pikseli."

msgid "The logo image could not be read."
msgstr "Nie udało się odczytać obrazu logo."

msgid "The logo could not be saved."
msgstr "Nie udało się zapisać logo."

msgid "Configuration saved."
msgstr "Konfiguracja została zapisana."

msgid "Item types"
msgstr "Typy zasobów"

msgid "Print labels for"
msgstr "Drukuj etykiety dla"

msgid "QR code"
msgstr "Kod QR"

msgid "The GLPI URL is not set (Setup > General), item links in QR codes will be incomplete."
msgstr "Adres URL GLPI nie jest ustawiony (Ustawienia > Ogólne), linki do zasobów w kodach QR będą niekompletne."

msgid "Link to the item in GLPI"
msgstr "Link do zasobu w GLPI"

msgid "Custom template"
msgstr "Własny szablon"

msgid "QR code content"
msgstr "Zawartość kodu QR"

msgid "Template"
msgstr "Szablon"

msgid "Used with \"Custom template\". Available fields: %s"
msgstr "Używany w trybie \"Własny szablon\". Dostępne pola: %s"

msgid "Label content"
msgstr "Zawartość etykiety"

msgid "Additional label"
msgstr "Dodatkowa etykieta"

msgid "For example: \"Property of ACME\" or \"S/N: {serial}\". Available fields: %s"
msgstr "Na przykład: \"Własność: ACME\" albo \"S/N: {serial}\". Dostępne pola: %s"

msgid "Logo"
msgstr "Logo"

msgid "Upload a logo"
msgstr "Prześlij logo"

msgid "PNG, JPEG, GIF or WebP, at most 2 MB. It is converted to grayscale."
msgstr "PNG, JPEG, GIF lub WebP, do 2 MB. Logo jest konwertowane do skali szarości."

msgid "Delete the current logo"
msgstr "Usuń obecne logo"

msgid "Output"
msgstr "Wydruk"

msgid "Default format"
msgstr "Domyślny format"

msgid "Sharp text (no anti-aliasing)"
msgstr "Ostry tekst (bez wygładzania)"

msgid "Pure black text without gray edges; can look crisper on thermal printers."
msgstr "Czysto czarny tekst bez szarych krawędzi; na drukarkach termicznych może być wyraźniejszy."

msgid "Preview"
msgstr "Podgląd"

msgid "Printer test (PDF with safe area frame)"
msgstr "Test drukarki (PDF z ramką obszaru bezpiecznego)"

msgid "Label type"
msgstr "Rodzaj etykiety"

msgid "Label length on continuous tape (mm)"
msgstr "Długość etykiety na taśmie ciągłej (mm)"

msgid "Used only with continuous tapes."
msgstr "Używana tylko z taśmami ciągłymi."

msgid "DK-22210 (29 mm continuous tape)"
msgstr "DK-22210 (taśma ciągła 29 mm)"


msgid "DK-22205 (62 mm continuous tape)"
msgstr "DK-22205 (taśma ciągła 62 mm)"

msgid "%1$s, %2$d mm long"
msgstr "%1$s, długość %2$d mm"

msgid "The ZIP archive could not be created. Check that the GLPI temporary directory (files/_tmp) is writable."
msgstr "Nie udało się utworzyć archiwum ZIP. Sprawdź, czy katalog tymczasowy GLPI (files/_tmp) jest zapisywalny."

msgid "The logo file is larger than the server upload limit (%s). Choose a smaller file."
msgstr "Plik logo jest większy niż limit przesyłania na serwerze (%s). Wybierz mniejszy plik."

msgid "The logo could not be uploaded. Try again; if it keeps failing, check the PHP upload settings."
msgstr "Nie udało się przesłać logo. Spróbuj ponownie, a jeśli błąd się powtarza, sprawdź ustawienia przesyłania plików w PHP."

msgid "AirPrint direct printing"
msgstr "Druk bezpośredni AirPrint"

msgid "Requirements"
msgstr "Wymagania"

msgid "Available"
msgstr "Dostępne"

msgid "Missing"
msgstr "Brak"

msgid "PHP gd extension with FreeType (renders the labels)"
msgstr "Rozszerzenie PHP gd z FreeType (rysowanie etykiet)"

msgid "PHP curl extension or allow_url_fopen (IPP requests over HTTP)"
msgstr "Rozszerzenie PHP curl lub allow_url_fopen (zapytania IPP przez HTTP)"

msgid "Network printer with AirPrint (IPP on port 631), reachable from the GLPI server: check it with \"Test connection\""
msgstr "Drukarka sieciowa z AirPrint (IPP na porcie 631), osiągalna z serwera GLPI: sprawdź przyciskiem \"Test połączenia\""

msgid "No printer driver or other program is needed on the server."
msgstr "Na serwerze nie jest potrzebny sterownik drukarki ani inne programy."

msgid "Send labels to the printer"
msgstr "Wysyłaj etykiety do drukarki"

msgid "Adds \"Printer\" to the outputs of the label tab and of the bulk action; PDF and PNG stay available."
msgstr "Dodaje \"Drukarka\" do formatów wyjściowych zakładki etykiety i akcji masowej; PDF i PNG pozostają dostępne."

msgid "Printer address"
msgstr "Adres drukarki"

msgid "IP address or host name of the printer. It is used by the GLPI server, not by the browser."
msgstr "Adres IP lub nazwa hosta drukarki. Łączy się z nią serwer GLPI, a nie przeglądarka."

msgid "Test connection"
msgstr "Test połączenia"

msgid "Read the loaded paper from the printer"
msgstr "Odczytaj włożony papier z drukarki"

msgid "Selects the label type matching the paper loaded in the printer (needs the printer address below)."
msgstr "Wybiera typ etykiety zgodny z papierem włożonym do drukarki (wymaga adresu drukarki poniżej)."

msgid "Selected: %s. Save to apply."
msgstr "Wybrano: %s. Zapisz, aby zastosować."

msgid "The request failed. Reload the page and try again."
msgstr "Zapytanie nie powiodło się. Odśwież stronę i spróbuj ponownie."

msgid "Printer"
msgstr "Drukarka"

msgid "State"
msgstr "Stan"

msgid "Loaded paper"
msgstr "Włożony papier"

msgid "AirPrint raster (image/urf)"
msgstr "Raster AirPrint (image/urf)"

msgid "ready"
msgstr "gotowa"

msgid "printing"
msgstr "drukuje"

msgid "stopped"
msgstr "zatrzymana"

msgid "unknown"
msgstr "nieznany"

msgid "%s mm continuous tape"
msgstr "taśma ciągła %s mm"

msgid "Enter a valid IP address or host name."
msgstr "Wpisz poprawny adres IP lub nazwę hosta."

msgid "The printer does not accept AirPrint raster images (image/urf), direct printing will not work."
msgstr "Drukarka nie przyjmuje obrazów rastrowych AirPrint (image/urf), druk bezpośredni nie zadziała."

msgid "No label type of the plugin matches the loaded paper."
msgstr "Żaden typ etykiety wtyczki nie pasuje do włożonego papieru."

msgid "The printer address is not a valid IP address or host name; it has not been saved."
msgstr "Adres drukarki nie jest poprawnym adresem IP ani nazwą hosta; nie został zapisany."

msgid "Direct printing needs the printer address, so it has not been enabled."
msgstr "Druk bezpośredni wymaga adresu drukarki, dlatego nie został włączony."

msgid "Print on the printer"
msgstr "Drukuj na drukarce"

msgid "The label has been sent to the printer."
msgstr "Etykieta została wysłana do drukarki."

msgid "%d label has been sent to the printer."
msgid_plural "%d labels have been sent to the printer."
msgstr[0] "%d etykieta została wysłana do drukarki."
msgstr[1] "%d etykiety zostały wysłane do drukarki."
msgstr[2] "%d etykiet zostało wysłanych do drukarki."

msgid "Printer: all labels are sent to the printer as one job."
msgstr "Drukarka: wszystkie etykiety trafiają do drukarki jako jedno zadanie."

msgid "The printer sent an invalid IPP response."
msgstr "Drukarka wysłała nieprawidłową odpowiedź IPP."

msgid "The printer %s does not accept AirPrint raster images (image/urf)."
msgstr "Drukarka %s nie przyjmuje obrazów rastrowych AirPrint (image/urf)."

msgid "The printer is not ready: %s."
msgstr "Drukarka nie jest gotowa: %s."

msgid "The loaded paper (%1$s) does not match the label type in the configuration (%2$s)."
msgstr "Włożony papier (%1$s) nie pasuje do typu etykiety w konfiguracji (%2$s)."

msgid "The printer at %s cannot be reached. Check the address and that the printer is on."
msgstr "Brak połączenia z drukarką %s. Sprawdź adres i czy drukarka jest włączona."

msgid "The printer at %1$s does not accept IPP requests (HTTP error %2$d)."
msgstr "Drukarka %1$s nie przyjmuje zapytań IPP (błąd HTTP %2$d)."

msgid "The printer rejected the request: %s"
msgstr "Drukarka odrzuciła zapytanie: %s"

msgid "8-bit grayscale (W8)"
msgstr "8-bitowa skala szarości (W8)"

msgid "Resolution"
msgstr "Rozdzielczość"

msgid "The printer does not accept 8-bit grayscale AirPrint images (W8), direct printing will not work."
msgstr "Drukarka nie przyjmuje obrazów AirPrint w 8-bitowej skali szarości (W8), druk bezpośredni nie zadziała."

msgid "The printer does not print AirPrint images at %d dpi, direct printing will not work."
msgstr "Drukarka nie drukuje obrazów AirPrint w rozdzielczości %d dpi, druk bezpośredni nie zadziała."

msgid "The printer %s does not accept 8-bit grayscale AirPrint images (W8)."
msgstr "Drukarka %s nie przyjmuje obrazów AirPrint w 8-bitowej skali szarości (W8)."

msgid "The printer %1$s does not print AirPrint images at %2$d dpi."
msgstr "Drukarka %1$s nie drukuje obrazów AirPrint w rozdzielczości %2$d dpi."

msgid "Cutting"
msgstr "Cięcie"

msgid "Print quality"
msgstr "Jakość druku"

msgid "After each label"
msgstr "Po każdej etykiecie"

msgid "Once, after the last label"
msgstr "Raz, po ostatniej etykiecie"

msgid "Do not cut"
msgstr "Bez cięcia"

msgid "Normal"
msgstr "Normalna"

msgid "High (slower)"
msgstr "Wysoka (wolniej)"

msgid "not supported"
msgstr "nieobsługiwane"

msgid "\"Once, after the last label\" gives one strip with all the labels: handy with die-cut labels, which peel off the strip, but on continuous tape the labels then have to be cut by hand. Used when the printer supports it (see \"Test connection\")."
msgstr "\"Raz, po ostatniej etykiecie\" daje jeden pasek ze wszystkimi etykietami: wygodne przy etykietach wstępnie wyciętych, które odkleja się z paska, ale na taśmie ciągłej etykiety trzeba potem rozciąć ręcznie. Stosowane, gdy drukarka je obsługuje (zobacz \"Test połączenia\")."

msgid "Used when the printer supports it (see \"Test connection\")."
msgstr "Stosowane, gdy drukarka je obsługuje (zobacz \"Test połączenia\")."

msgid "The printer does not support this setting and will use its own default."
msgstr "Drukarka nie obsługuje tego ustawienia i użyje własnego ustawienia domyślnego."

msgid "Connecting to the printer..."
msgstr "Łączenie z drukarką..."
